if ! command -v git >/dev/null 2>&1; then
echo "installing git"
sudo pacman -S git --noconfirm
echo ""
fi

if ! command -v gum >/dev/null 2>&1; then
echo "installing gum"
zerossudo pacman -S gum --noconfirm
fi

git clone https://github.com/zer-os/zer-os.git ~/.zerosinstall/
cd ~/.zerosinstall/
chmod +x index
clear
gum confirm && ~/.zerosinstall/index || echo "installation cancelled"
